# Applies to the backend image's build context (repo root -- see
# docker-compose.yml and backend/Dockerfile). The frontend image builds
# from ./frontend and uses frontend/.dockerignore instead.

.git
.github
docs
*.md

# Python
**/__pycache__/
**/*.pyc
backend/.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/.cache/
backend/.discovery_state/
backend/.document_store/
backend/.emerging_themes_state/
backend/.taxonomy_researcher_state/
backend/.calibration_state/
backend/.portfolio_monitoring_state/

# Frontend (not needed inside the backend image at all)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Runtime data / secrets -- never bake local run history or credentials
# into an image layer
runs/
taxonomies/
portfolios/
data/documents/
engagements/
ballots/
.env
.env.*
!backend/.env.example
!frontend/.env.example

.DS_Store
