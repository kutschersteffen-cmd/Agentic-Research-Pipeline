# Copy to backend/.env and fill in. All settings are also overridable via
# environment variables with the ARP_ prefix (e.g. ARP_LLM_MODEL).

ARP_ANTHROPIC_API_KEY=sk-ant-...
ARP_LLM_MODEL=claude-sonnet-5-5
# Verifier/Kritiker model -- deliberately different from ARP_LLM_MODEL so
# extractor and verifier don't share failure modes. See arp/config.py.
ARP_LLM_VERIFIER_MODEL=claude-opus-5-5

# Concurrency / cost controls for large batch runs
ARP_MAX_CONCURRENT_LLM_CALLS=8
ARP_MAX_CONCURRENT_DOWNLOADS=4

# Precision controls
ARP_GROUNDING_FUZZY_THRESHOLD=0.92
ARP_CONFIDENCE_REVIEW_THRESHOLD=0.6

# Hybrid (BM25 + local multilingual embedding) evidence retrieval -- on by
# default; set false to fall back to pure BM25.
ARP_HYBRID_RETRIEVAL_ENABLED=true

# XBRL structured-facts Path 0 ahead of the LLM for EDGAR filers' CapEx/R&D
# totals (SEC's free companyfacts API) -- on by default.
ARP_XBRL_FACTS_ENABLED=true

# Opt-in Postgres/pgvector store (requires: pip install -e ".[postgres]").
# Leave unset to keep every store file-based (the default).
# ARP_POSTGRES_DSN=postgresql+psycopg://user:pass@localhost:5432/arp
# ARP_PORTFOLIO_BACKEND=postgres   # or "file" (default)
# ARP_EMBEDDINGS_BACKEND=postgres  # or "sqlite" (default)
# Postgres read-model projections beyond Portfolio/Holdings -- each mirrors
# an existing file/SQLite store, which stays authoritative either way.
# ARP_DOCUMENT_REGISTRY_PROJECTION_ENABLED=true
# ARP_COMPANY_RECORDS_PROJECTION_ENABLED=true
# ARP_COMPANY_FACTS_PROJECTION_ENABLED=true
# ARP_ENGAGEMENT_PROJECTION_ENABLED=true

# Opt-in Apache Superset BI designer (arp/bi/; needs the Postgres store above).
# Read by the backend AND by the compose `superset` service, which gets them
# only via `docker compose --env-file backend/.env up -d postgres superset`.
# No defaults: Superset refuses to start while a secret is unset or still a
# placeholder below, and the two SUPERSET_* secrets need >= 32 characters.
# Generate each with `openssl rand -base64 42`.
# SUPERSET_SECRET_KEY=change-me-dev-only
# SUPERSET_GUEST_TOKEN_JWT_SECRET=change-me-dev-only
# ARP_SUPERSET_URL=http://127.0.0.1:8088
# The Superset account, created by the superset container at boot:
# ARP_SUPERSET_USER=arp_designer
# ARP_SUPERSET_PASSWORD=change-me-dev-only
# Password of the bi_reader Postgres role Superset reads the bi views as:
# ARP_BI_READER_PASSWORD=change-me-dev-only
# Where Superset (not the CLI) reaches Postgres, for `arp bi bootstrap`:
# ARP_BI_SUPERSET_DB_HOST=postgres:5432

# Opt-in OpenSearch store (requires: pip install -e ".[opensearch]") --
# powers the user-facing search feature and, opt-in, an alternate BM25
# retrieval backend. Leave unset to keep search/retrieval exactly as today.
# ARP_OPENSEARCH_URL=http://localhost:9200
# ARP_SEARCH_LIVE_INDEXING_ENABLED=true
# ARP_RETRIEVAL_BACKEND=opensearch   # or "bm25" (default)

# Opt-in S3-compatible object store (requires: pip install -e ".[object_storage]")
# -- an immutable copy of each source document (MinIO locally). Leave unset
# and a verified copy of each document's original bytes is still always
# written, to the local blob store (ARP_BLOB_STORE_DIR, default data/blobs).
# Either way, if the copy cannot be stored and verified the document is not
# collected (it is retried on the next fetch).
# ARP_BLOB_STORE_DIR=data/blobs

# ARP_OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
# ARP_OBJECT_STORE_ACCESS_KEY=arp
# ARP_OBJECT_STORE_SECRET_KEY=arp12345
# ARP_OBJECT_STORE_BUCKET=arp-documents
# ARP_OBJECT_STORE_LIVE_UPLOAD_ENABLED=true

# XBRL Facts function: files only, no database (default data/xbrl).
# ARP_XBRL_DIR=data/xbrl

# SEC EDGAR requires a descriptive User-Agent with contact info
ARP_EDGAR_USER_AGENT="Agentic Research Pipeline you@example.com"

# Document discovery (crawler + scheduler)
ARP_DISCOVERY_USER_AGENT="ARP-DiscoveryBot/0.1 (+research use; respects robots.txt)"
ARP_DISCOVERY_WEBHOOK_URL=
ARP_DISCOVERY_SCHEDULE_ENABLED=false
ARP_DISCOVERY_SCHEDULE_INTERVAL_HOURS=24
ARP_DISCOVERY_SCHEDULE_UNIVERSE_PATH=

# Sign-in (README "Sign-in"). Current default: 'dev' -- requests from
# 127.0.0.1/::1 (plus ARP_DEV_TRUSTED_NETWORKS) are signed in as ARP_DEV_USER
# (approver) without a token. Local machine only; never behind a same-host proxy.
# To switch to real sign-in: copy config/users.example.json to config/users.json,
# give each person a long random token, set ARP_AUTH_MODE=local, restart the API.
ARP_AUTH_MODE=dev
# ARP_DEV_USER=dev
# Extra CIDRs dev mode trusts, as JSON (docker-compose sets the Docker bridge range).
# ARP_DEV_TRUSTED_NETWORKS=["172.16.0.0/12"]
# ARP_USERS_FILE=../config/users.json
# CORS allow-list for the browser UI, as JSON.
# ARP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# For CLI writes (arp index approve, calibration-save, ...), set in your shell, not here:
# ARP_CLI_TOKEN=<your token from config/users.json>
