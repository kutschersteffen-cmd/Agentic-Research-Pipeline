# Copy to backend/.env and fill in. All settings are also overridable via
# environment variables with the ARP_ prefix (e.g. ARP_LLM_MODEL).

ARP_ANTHROPIC_API_KEY=sk-ant-...
ARP_LLM_MODEL=claude-sonnet-5

# Concurrency / cost controls for large batch runs
ARP_MAX_CONCURRENT_LLM_CALLS=8
ARP_MAX_CONCURRENT_DOWNLOADS=4

# Precision controls
ARP_GROUNDING_FUZZY_THRESHOLD=0.92
ARP_CONFIDENCE_REVIEW_THRESHOLD=0.6

# SEC EDGAR requires a descriptive User-Agent with contact info
ARP_EDGAR_USER_AGENT="Agentic Research Pipeline you@example.com"

# Document discovery (crawler + scheduler)
ARP_DISCOVERY_USER_AGENT="ARP-DiscoveryBot/0.1 (+research use; respects robots.txt)"
ARP_DISCOVERY_WEBHOOK_URL=
ARP_DISCOVERY_SCHEDULE_ENABLED=false
ARP_DISCOVERY_SCHEDULE_INTERVAL_HOURS=24
ARP_DISCOVERY_SCHEDULE_UNIVERSE_PATH=
