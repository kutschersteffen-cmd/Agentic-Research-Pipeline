      "weight": 600,
      "font": "heading"
    },
    "body": {
      "size": 28,
      "line_height": 1.4,
      "weight": 400,
      "font": "body"
    },
    "caption": {
      "size": 20,
      "line_height": 1.3,
      "weight": 400,
      "font": "body"
