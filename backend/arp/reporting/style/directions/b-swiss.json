{
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "grid": {
    "columns": 12,
    "margin_x": 96,
    "margin_top": 96,
    "margin_bottom": 96,
    "gutter": 32,
    "headline_band": 180,
    "footer_band": 56,
    "rule_width": 1728,
    "rule_height": 3
  },
  "type": {
    "headline": {
      "size": 56,
      "line_height": 1.12,
      "weight": 600,
      "font": "heading"
    },
    "subhead": {
      "size": 36,
