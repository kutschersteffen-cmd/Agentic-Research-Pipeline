{
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "grid": {
    "columns": 12,
    "margin_x": 96,
    "margin_top": 96,
    "margin_bottom": 96,
    "gutter": 32,
    "headline_band": 180,
    "footer_band": 56,
    "rule_width": 72,
    "rule_height": 6
  },
  "type": {
    "headline": {
      "size": 56,
      "line_height": 1.12,
      "weight": 600,
      "font": "heading"
    },
    "subhead": {
      "size": 36,
      "line_height": 1.25,
      "weight": 600,
      "font": "heading"
    },
    "body": {
      "size": 28,
      "line_height": 1.4,
      "weight": 400,
      "font": "body"
    },
    "caption": {
      "size": 20,
      "line_height": 1.3,
      "weight": 400,
      "font": "body"
    },
    "big_number": {
      "size": 160,
      "line_height": 1.0,
      "weight": 600,
      "font": "heading"
    }
  },
  "color": {
    "ink": "#1A1817",
    "ink_muted": "#5A5550",
    "neutral": "#E4E0DA",
    "accent": "#8E1B32",
    "background": "#FFFFFF",
    "categorical": [
      "#8E1B32",
      "#857A6D",
      "#B0662A",
      "#3C7A5A",
      "#6B4E8C",
      "#2F5D8A",
      "#1E7F86",
      "#A04E6E"
    ]
  },
  "fonts": {
    "heading": "'Source Serif 4', Georgia, serif",
    "body": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif"
  }
}
