{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: Full automated setup",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/windows/setup.ps1"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Setup: Check (diagnostics)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/windows/check-setup.ps1"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Run tests",
      "type": "shell",
      "command": "conda",
      "args": ["run", "--no-capture-output", "-n", "arp", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Start (auto-reload)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/windows/run-backend.ps1"
      ],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "arp-backend",
        "pattern": { "regexp": "^ZZZ_NO_MATCH_ZZZ$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Will watch for changes|Started server process|Uvicorn running",
          "endsPattern": "Application startup complete\\."
        }
      }
    },
    {
      "label": "Frontend: Install dependencies",
      "type": "shell",
      "command": "conda",
      "args": ["run", "--no-capture-output", "-n", "arp", "npm", "install"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Start dev server",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/windows/run-frontend.ps1"
      ],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "arp-frontend",
        "pattern": { "regexp": "^ZZZ_NO_MATCH_ZZZ$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Frontend: Lint",
      "type": "shell",
      "command": "conda",
      "args": ["run", "--no-capture-output", "-n", "arp", "npm", "run", "lint"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
