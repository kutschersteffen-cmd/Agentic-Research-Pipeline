{
  "python.defaultInterpreterPath": "REPLACE_ME_RUN_scripts_windows_setup.ps1",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["backend/tests"],
  "python.analysis.extraPaths": ["backend"],
  "python.envFile": "${workspaceFolder}/backend/.env",
  // UTF-8 text I/O regardless of the OS locale. Without it, Python on a
  // Western-European Windows install defaults to cp1252, and a store file
  // written as UTF-8 reads back as mojibake ("Munchener Ruck" gains an A-tilde)
  // with no error raised. arp/storage/atomic_io.py names its own encoding; this
  // covers the CLI and ingestion paths that still use a plain open(), and
  // applies to the integrated terminal, the test runner and the debugger alike.
  "terminal.integrated.env.windows": { "PYTHONUTF8": "1" },
  "terminal.integrated.env.linux": { "PYTHONUTF8": "1" },
  "terminal.integrated.env.osx": { "PYTHONUTF8": "1" },
  "ruff.nativeServer": "on",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/runs/**": true,
    "**/backend/.cache/**": true,
    "**/backend/.document_store/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/frontend/dist": true,
    "**/runs": true,
    "**/data/documents": true
  }
}
